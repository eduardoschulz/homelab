# =============================================================================
# passwords.yml — EXAMPLE / TEMPLATE
#
# !! DO NOT commit plaintext passwords to git !!
#
# How to generate the real file:
#
#   1. Copy the default from Kolla-Ansible:
#        cp $VENV_DIR/share/kolla-ansible/etc_examples/kolla/passwords.yml \
#           etc/kolla/passwords.yml
#
#   2. Fill with random passwords:
#        kolla-genpwd --passwords etc/kolla/passwords.yml
#
#   3. Encrypt for Git (choose one):
#
#      Option A — Ansible Vault:
#        ansible-vault encrypt etc/kolla/passwords.yml
#        # Store the vault password as GitHub secret: ANSIBLE_VAULT_PASSWORD
#
#      Option B — SOPS:
#        sops --encrypt --age <recipient> etc/kolla/passwords.yml > etc/kolla/passwords.enc.yml
#
# The CI pipeline decrypts at runtime, runs deploy, then re-encrypts.
# =============================================================================
