# =============================================================================
# Kolla-Ansible inventory — single-node (remote target)
# Generated from the stock kolla-ansible all-in-one, adapted for remote host.
#
# Target: control01 = 192.168.0.10
# Deployment runs from localhost (the GitOps runner / CI agent).
# =============================================================================

[control]
control01 ansible_host=192.168.0.10 ansible_user=ubuntu

[network]
control01

[compute]
control01

[storage]
control01

[monitoring]
# control01

# ---------------------------------------------------------------------------
# The deployment host (where kolla-ansible is invoked)
# ---------------------------------------------------------------------------
[deployment]
localhost       ansible_connection=local

# =============================================================================
# Service-to-host mappings (from stock all-in-one)
# These are needed to map containerised services to host groups.
# =============================================================================

[common:children]
control
network
compute
storage
monitoring

[baremetal:children]
control

[tls-backend:children]
control

[grafana:children]
monitoring

[etcd:children]
control

